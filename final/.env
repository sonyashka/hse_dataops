# PostgreSQL configuration (общая)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow Database
MLFLOW_POSTGRES_USER=mlflow_user
MLFLOW_POSTGRES_PASSWORD=mlflow_password123
MLFLOW_POSTGRES_DB=mlflow_db

# Airflow Database
AIRFLOW_POSTGRES_USER=airflow_user
AIRFLOW_POSTGRES_PASSWORD=airflow_password123
AIRFLOW_POSTGRES_DB=airflow_db

# Airflow configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=my_super_secret_key_change_in_production
AIRFLOW__WEBSERVER__PORT=8080